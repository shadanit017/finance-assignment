# Node Environment & Server Port
NODE_ENV=development
PORT=3000

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=financial_insights
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Prisma Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/financial_insights

# Frontend Application Origin
FRONTEND_URL=http://localhost:5173

# Session Secret Key
SESSION_SECRET=super_secret_session_key_change_in_production

# Google OAuth 2.0 Credentials (Optional: required only for Google Login)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Default Active AI Provider (Options: gemini | openai | claude)
AI_PROVIDER=gemini

# -----------------------------------------------------------------
# AI Model Provider API Keys & Model Selections
# -----------------------------------------------------------------

# 1. Google Gemini API Key & Model Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. OpenAI ChatGPT API Key & Model Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 3. Anthropic Claude API Key & Model Configuration
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
# Optional Anthropic Workspace ID (if your Anthropic API key requires workspace scoping)
CLAUDE_WORKSPACE_ID=
